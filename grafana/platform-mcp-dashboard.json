{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Request rate by tool class",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {"expr": "sum by (tool_class, outcome) (rate(platform_mcp_requests_total[5m]))", "legendFormat": "{{tool_class}} / {{outcome}}"}
      ]
    },
    {
      "title": "Request latency p50 / p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(platform_mcp_request_duration_seconds_bucket[5m])))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(platform_mcp_request_duration_seconds_bucket[5m])))", "legendFormat": "p95"}
      ]
    },
    {
      "title": "Backend outcomes",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {"expr": "sum by (tool_class, status_class) (rate(platform_mcp_backend_requests_total[5m]))", "legendFormat": "{{tool_class}} / {{status_class}}"}
      ]
    },
    {
      "title": "Security denials",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum(rate(platform_mcp_auth_denials_total[5m]))", "legendFormat": "auth"},
        {"expr": "sum(rate(platform_mcp_replay_denials_total[5m]))", "legendFormat": "replay"}
      ]
    },
    {
      "title": "Certificate lifetime",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 16},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"expr": "platform_mcp_certificate_expiry_seconds", "legendFormat": "seconds remaining"}]
    },
    {
      "title": "In-flight requests",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 16},
      "targets": [{"expr": "sum(platform_mcp_requests_in_flight)", "legendFormat": "requests"}]
    },
    {
      "title": "Contract and outcome anomalies",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 16},
      "targets": [
        {"expr": "sum(increase(platform_mcp_contract_mismatches_total[1h]))", "legendFormat": "contract mismatch"},
        {"expr": "sum(increase(platform_mcp_unknown_outcomes_total[1h]))", "legendFormat": "unknown outcome"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["stratum", "platform-mcp"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Stratum Platform MCP",
  "uid": "stratum-platform-mcp",
  "version": 1
}
