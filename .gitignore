# E2E uncovered-routes report: local alert-only artifact, generated mid-run.
# Must stay excluded so e2eattestation digest (git ls-files --others --exclude-standard)
# does not see it appear between the source_before/source_after snapshots.
test/e2e/stateful/uncovered-report.json

# E2E eval baselines: recorded via `--record-baseline` per point; gitignored so
# per-run regressions aren't committed as golden truth. Tracked README.md and
# knowledge latest.json (Task 2 contract) are unaffected by this pattern.
test/e2e/**/baselines/*.json

# Pre-commit framework
.pre-commit-framework/

# Codecov
.codecov.yml

