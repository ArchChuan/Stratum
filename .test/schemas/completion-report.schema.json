{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratum.local/schemas/completion-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "commit", "manifest_digest", "risk_level", "mode", "reviews", "capabilities", "attestation", "cleanup", "artifacts"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["accepted", "failed", "blocked", "incomplete"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "mode": { "enum": ["none", "short", "soak", "release-soak"] },
    "reviews": {
      "type": "object",
      "additionalProperties": { "enum": ["passed", "changes_requested", "blocked", "not_required"] }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "blocked", "skipped", "unreconciled"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "unreconciled": { "type": "integer", "minimum": 0 }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "verified", "path"],
      "properties": {
        "schema": { "const": 2 },
        "verified": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "residual_entities"],
      "properties": {
        "complete": { "type": "boolean" },
        "residual_entities": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "failed": { "const": 0 },
              "blocked": { "const": 0 },
              "skipped": { "const": 0 },
              "unreconciled": { "const": 0 }
            }
          },
          "attestation": { "properties": { "verified": { "const": true } } },
          "cleanup": { "properties": { "complete": { "const": true }, "residual_entities": { "const": 0 } } },
          "artifacts": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "accepted" },
          "risk_level": { "enum": ["R3", "R4"] }
        },
        "required": ["status", "risk_level"]
      },
      "then": {
        "properties": {
          "reviews": {
            "required": ["specification", "code-quality"],
            "properties": {
              "specification": { "const": "passed" },
              "code-quality": { "const": "passed" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "accepted" },
          "risk_level": { "const": "R4" }
        },
        "required": ["status", "risk_level"]
      },
      "then": {
        "properties": {
          "reviews": {
            "required": ["release-evidence"],
            "properties": { "release-evidence": { "const": "passed" } }
          }
        }
      }
    }
  ]
}
