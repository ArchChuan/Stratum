{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stratum.local/schemas/completion-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "commit", "manifest_digest", "risk_level", "mode", "reviews", "capabilities", "attestation", "cleanup", "artifacts"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["accepted", "failed", "blocked", "incomplete"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "risk_level": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "mode": { "enum": ["none", "short", "soak", "release-soak"] },
    "reviews": { "type": "array", "items": { "$ref": "#/$defs/review" }, "uniqueItems": true },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "failed", "blocked", "skipped", "unreconciled"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "unreconciled": { "type": "integer", "minimum": 0 }
      }
    },
    "attestation": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "verified", "signed", "issuer", "path", "bundle"],
          "properties": {
            "schema": { "const": 2 },
            "verified": { "type": "boolean" },
            "signed": { "type": "boolean" },
            "issuer": { "const": "github-actions-sigstore" },
            "path": { "type": "string", "minLength": 1 },
            "bundle": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "residual_entities"],
      "properties": {
        "complete": { "type": "boolean" },
        "residual_entities": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "failed": { "const": 0 },
              "blocked": { "const": 0 },
              "skipped": { "const": 0 },
              "unreconciled": { "const": 0 }
            }
          },
          "cleanup": { "properties": { "complete": { "const": true }, "residual_entities": { "const": 0 } } },
          "reviews": { "items": { "properties": { "status": { "const": "passed" } } } }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "none" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "attestation": { "type": "null" },
          "capabilities": {
            "properties": {
              "passed": { "const": 0 },
              "failed": { "const": 0 },
              "blocked": { "const": 0 },
              "skipped": { "const": 0 },
              "unreconciled": { "const": 0 }
            }
          }
        }
      },
      "else": { "properties": { "attestation": { "type": "object" } } }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "accepted" },
          "mode": { "enum": ["short", "soak", "release-soak"] }
        },
        "required": ["status", "mode"]
      },
      "then": {
        "properties": {
          "attestation": { "properties": { "verified": { "const": true }, "signed": { "const": true } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "accepted" },
          "risk_level": { "enum": ["R1", "R2", "R3", "R4"] }
        },
        "required": ["status", "risk_level"]
      },
      "then": {
        "properties": {
          "reviews": {
            "contains": {
              "properties": { "type": { "const": "code-quality" }, "status": { "const": "passed" } },
              "required": ["type", "status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "accepted" },
          "risk_level": { "enum": ["R2", "R3", "R4"] }
        },
        "required": ["status", "risk_level"]
      },
      "then": {
        "properties": {
          "reviews": {
            "contains": {
              "properties": { "type": { "const": "specification" }, "status": { "const": "passed" } },
              "required": ["type", "status"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "accepted" },
          "risk_level": { "const": "R4" }
        },
        "required": ["status", "risk_level"]
      },
      "then": {
        "properties": {
          "reviews": {
            "contains": {
              "properties": { "type": { "const": "release-evidence" }, "status": { "const": "passed" } },
              "required": ["type", "status"]
            }
          },
          "artifacts": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "status", "reviewer", "commit", "policy_version", "findings", "evidence"],
      "properties": {
        "type": { "enum": ["specification", "code-quality", "release-evidence"] },
        "status": { "enum": ["passed", "changes_requested", "blocked"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "policy_version": { "type": "integer", "minimum": 1 },
        "findings": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
